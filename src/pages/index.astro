---
import Base from '../layouts/Base.astro';
import Skyline from '../components/Skyline.astro';
import { trip, foods } from '../data/itinerary';
import { checklist } from '../data/checklist';
const total = checklist.reduce((n, g) => n + g.items.length, 0);

const totalActual = trip.budgetSummary.reduce((s, i) => s + i.amount, 0);
const estTwd = Math.round(totalActual / trip.krwPerTwd);
const leftTwd = trip.budget - estTwd;
const overBudget = leftTwd < 0;
const allLocationsJson = JSON.stringify(trip.locations);
const tools = [
  { href: '/tickets', title: '預訂資料', desc: '航班、住宿、退稅提醒' },
  { href: '/planner', title: '規劃工作台', desc: '拖曳排序、編輯活動、即時預算' },
  { href: '/planb', title: '應變中心', desc: '雨天替代方案、延誤應對' },
  { href: '/import', title: '資料匯入', desc: '貼上確認信解析、備份還原' },
];
---

<Base title="釜山三日自由行">
  <header class="hero">
    <div class="hero-inner">
      <div class="hangul" lang="ko">부산</div>
      <h1>{trip.title}</h1>
      <p class="subtitle">{trip.subtitle}</p>
      <div class="meta">
        <span>{trip.dates}</span>
        <span>{trip.travelers} 人</span>
        <span>每人預算 {trip.budgetPerPerson.toLocaleString()} {trip.budgetCurrency}</span>
      </div>
      <Skyline />
    </div>
  </header>

  <main class="container" style="padding-top:1.5rem;">
    <div class="pwa-banner" id="pwa-install">
      安裝到主畫面，離線也能看行程
      <br /><button id="install-btn">安裝 App</button>
    </div>

    <div class="facts">
      <div><b>{trip.days.length} 天</b><span>06:10 抵達，22:00 返程</span></div>
      <div><b>3 家</b><span>豬肉湯飯，一天一家</span></div>
      <div><b>₩{totalActual.toLocaleString()}</b><span>預估總花費，約 {estTwd.toLocaleString()} 元台幣</span></div>
      <div><b class={overBudget ? 'over' : ''}>{overBudget ? '超出' : '剩'} {Math.abs(leftTwd).toLocaleString()}</b><span>對照預算 {trip.budget.toLocaleString()} 元（每人 {trip.budgetPerPerson.toLocaleString()}），匯率抓 1:{trip.krwPerTwd}</span></div>
    </div>

    <a class="note" href="/prepare" style="display:block;text-decoration:none;color:inherit;">
      <strong>出發前待辦：<span id="prep-done">0</span> / {total}</strong>
      證件、K-ETA、好市多會員卡、轉接頭、退稅用品，點進去逐項確認
    </a>

    <div class="note">
      <strong>{trip.hotel.name}</strong>
      {trip.hotel.note}
    </div>

    <div class="weather-banner">
      <div class="icon" aria-hidden="true">🍂</div>
      <div>
        <strong>{trip.weather.condition}</strong><br />
        {trip.weather.temp}・{trip.weather.tip}
      </div>
    </div>

    <h2 style="margin:1.5rem 0 0.75rem;">每日行程</h2>
    <ul class="day-list">
      {trip.days.map(day => (
        <li>
          <a href={`/day${day.day}`}>
            <span class="d">{day.day}</span>
            <span class="t">{day.title}</span>
            <span class="b">₩{day.dayBudget.toLocaleString()}</span>
            <span class="s">{day.date}・{day.subtitle}</span>
          </a>
        </li>
      ))}
    </ul>

    <h2 style="margin:2rem 0 0.75rem;">要吃的</h2>
    <div class="food-grid">
      {foods.map(f => (
        <a class="food-card" href={f.gmap} target="_blank" rel="noopener" style="text-decoration:none;color:inherit;">
          <strong>{f.name}</strong>
          <div style="font-size:0.9rem;color:var(--muted);">{f.desc}</div>
          <div style="font-size:0.85rem;margin-top:0.25rem;">{f.price}</div>
        </a>
      ))}
    </div>

    <h2 style="margin:2rem 0 0.75rem;">預算（韓元）</h2>
    <div class="card">
      <table class="budget-table">
        <thead><tr><th>項目</th><th>金額</th><th>備註</th></tr></thead>
        <tbody>
          {trip.budgetSummary.map(i => (
            <tr><td>{i.label}</td><td><strong>₩{i.amount.toLocaleString()}</strong></td><td style="color:var(--muted);font-size:0.85rem;">{i.note}</td></tr>
          ))}
          <tr class="total-row"><td>總計</td><td>₩{totalActual.toLocaleString()}</td><td style="color:var(--muted);font-size:0.85rem;">預估</td></tr>
        </tbody>
      </table>
    </div>

    <h2 style="margin:2rem 0 0.75rem;">地圖</h2>
    <div class="card">
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <div id="index-map" style="width:100%;height:340px;border-radius:6px;"></div>
    </div>

    <h2 style="margin:2rem 0 0.75rem;">工具</h2>
    <ul class="link-list">
      {tools.map(t => (
        <li><a href={t.href}><span>{t.title}<small>{t.desc}</small></span></a></li>
      ))}
    </ul>
  </main>

  <footer class="footer">
    <p>地圖資料 © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors</p>
  </footer>
</Base>

<script define:vars={{ allLocationsJson }}>
  try {
    const s = JSON.parse(localStorage.getItem('busan-prepare') || '{}');
    document.getElementById('prep-done').textContent = Object.values(s).filter(Boolean).length;
  } catch {}
  const locations = JSON.parse(allLocationsJson);
  const css = getComputedStyle(document.documentElement);
  const c = n => css.getPropertyValue(n).trim();
  const script = document.createElement('script');
  script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
  script.onload = () => {
    const L = window.L;
    const map = L.map('index-map').setView([35.13, 129.08], 11);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19,
    }).addTo(map);
    const colors = { airport: c('--sky'), hotel: c('--teal'), food: c('--red'), shopping: c('--yellow'), outdoor: c('--teal'), market: c('--red') };
    locations.forEach(loc => {
      L.circleMarker([loc.lat, loc.lng], {
        radius: 8, fillColor: colors[loc.icon] || c('--teal'), color: '#fff', weight: 2, fillOpacity: 0.9,
      }).addTo(map).bindPopup(`<strong>${loc.name}</strong>`);
    });
  };
  document.head.appendChild(script);
</script>
