---
import Base from '../layouts/Base.astro';
import Skyline from '../components/Skyline.astro';
import { trip } from '../data/itinerary';

const kk = (q) => `https://www.kkday.com/zh-tw/product/productlist?keyword=${encodeURIComponent(q)}`;
const kl = (q) => `https://www.klook.com/zh-TW/search/result/?query=${encodeURIComponent(q)}`;

const groups = [
  {
    title: '已訂好',
    items: [
      { id: 'flight-out', text: '去程 7C6164　10/31 02:50 桃園 → 06:10 釜山', note: '濟州航空，第一航廈，託運 15kg' },
      { id: 'flight-back', text: '回程 7C6163　11/2 22:00 釜山 → 23:50 桃園', note: '託運 15kg＋5kg' },
      { id: 'hotel', text: `住宿　${trip.hotel.name}`, note: trip.hotel.note + '。訂單編號請看訂房信，不放在這個公開網頁' },
    ],
  },
  {
    title: '建議先買（KKday 或 Klook 擇一，下單前兩邊比價）',
    items: [
      {
        id: 'esim',
        text: '韓國 eSIM（3 人各一張，或選可分享的方案）',
        note: '地圖、叫車、查營業時間都靠網路。可在桃園機場候機時用台灣網路先裝好，落地就能用。一天約 NT$60–70 的 5G 方案常見，價格常變',
        links: [['KKday', kk('韓國 eSIM')], ['Klook', kl('韓國 eSIM')]],
      },
      {
        id: 'tmoney',
        text: 'T-money 或 WOWPASS 交通卡（機場取貨）',
        note: '06:10 落地就要搭輕軌與地鐵。也可以在機場輕軌站的 Emart24 現場買，約 ₩4,000 加儲值至少 ₩10,000；預購的好處是不用找店。WOWPASS 可在機台用台幣換韓元',
        links: [['KKday', kk('釜山 T-money')], ['Klook', kl('釜山 T-money')]],
      },
    ],
  },
  {
    title: '看情況（不一定要訂）',
    items: [
      {
        id: 'transfer-in',
        text: '去程機場接送到西面飯店',
        note: '輕軌加地鐵約 ₩1,800、約 1 小時多，05:00 已營運。計程車約 ₩18,000–20,000、約 25 分鐘。三人帶 15kg 行李且睡不到，才考慮預訂專車（KKday 台灣站約 NT$1,648 起）',
        links: [['KKday', kk('釜山 金海機場 接送')], ['Klook', kl('釜山 金海機場 接送')]],
      },
      {
        id: 'charter',
        text: 'Day 1 包車（機場 → 飯店 → 好市多 → 市區）',
        note: '當天計程車共 3 趟約 ₩110,000。若想省去叫車與換車，可比較一天包車的價格；叫車用 Kakao T 也可以',
        links: [['KKday', kk('釜山 包車')], ['Klook', kl('釜山 包車')]],
      },
      {
        id: 'transfer-out',
        text: '回程 18:30 出發去機場',
        note: '同上；回程多了採買行李，三人約 20kg 加上保養品，計程車較輕鬆，不需預訂',
      },
    ],
  },
  {
    title: '不用預訂（現場就好）',
    items: [
      { id: 'costco', text: '好市多釜山店（Day 1 下午）', note: '帶會員卡與護照入場，無需預約。10/31 是週六，不在週日公休範圍內，10:00 開門' },
      { id: 'soup', text: '三家豬肉湯飯', note: '多半不接受訂位，只能現場排隊；수변최고 在平台上可線上候位，其他先避開用餐尖峰' },
      { id: 'crab', text: '札嘎其市場帝王蟹', note: '現場挑選與議價，無法預訂。公休是每月第 1、3、5 個週二，10/31 不受影響' },
      { id: 'oy', text: 'Olive Young 與西面購物', note: '直接逛。平台上可能有購物折價券，我沒有查證，下單前自己看內容與使用條件' },
    ],
  },
];
const total = groups.reduce((n, g) => n + g.items.length, 0);
---

<Base title="預訂清單">
  <header class="hero compact">
    <div class="hero-inner">
      <a href="/" class="back">回總覽</a>
      <h1>預訂清單</h1>
      <p class="subtitle">哪些要先上網買，哪些現場就好</p>
      <Skyline />
    </div>
  </header>

  <main class="container" style="padding-top:1.25rem;">
    <div class="note">
      <strong>已確認 <span id="done">0</span> / {total}</strong>
      這趟真正需要先上網買的只有 eSIM 與交通卡，其餘大多現場處理。價格與庫存請在平台上看最新資訊。
      <div class="toolbar" style="margin:0.75rem 0 0;">
        <button class="btn secondary" id="reset" type="button">全部取消勾選</button>
      </div>
    </div>

    {groups.map(g => (
      <section class="card">
        <h2>{g.title}</h2>
        <ul class="todo">
          {g.items.map(i => (
            <li>
              <label>
                <input type="checkbox" data-id={i.id} />
                <span>
                  <span class="todo-text">{i.text}</span>
                  {i.note && <small>{i.note}</small>}
                  {i.links && (
                    <small class="shop-links">
                      {i.links.map(([name, href]) => <a href={href} target="_blank" rel="noopener">在 {name} 搜尋</a>)}
                    </small>
                  )}
                </span>
              </label>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>

  <footer class="footer">
    <a href="/">回總覽</a>
  </footer>
</Base>

<style is:global>
  .todo { list-style: none; border-top: 1px solid var(--line); }
  .todo li { border-bottom: 1px solid var(--line); }
  .todo label { display: flex; gap: 0.75rem; padding: 0.8rem 0.25rem; cursor: pointer; align-items: flex-start; }
  .todo input { width: 1.25rem; height: 1.25rem; margin-top: 0.2rem; accent-color: var(--teal); flex-shrink: 0; }
  .todo small { display: block; color: var(--muted); font-size: 0.85rem; max-width: 60ch; }
  .todo input:checked + span .todo-text { text-decoration: line-through; color: var(--muted); }
  .shop-links { display: flex !important; gap: 1rem; margin-top: 0.35rem; }
  .shop-links a { color: var(--teal-dark); font-weight: 500; }
</style>

<script>
  const KEY = 'busan-tickets';
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.todo input'));
  const done = document.getElementById('done')!;
  const saved: Record<string, boolean> = JSON.parse(localStorage.getItem(KEY) || '{}');
  const update = () => {
    done.textContent = String(boxes.filter(b => b.checked).length);
    localStorage.setItem(KEY, JSON.stringify(Object.fromEntries(boxes.map(b => [b.dataset.id, b.checked]))));
  };
  boxes.forEach(b => {
    b.checked = !!saved[b.dataset.id!];
    b.addEventListener('change', update);
  });
  document.getElementById('reset')!.addEventListener('click', () => {
    boxes.forEach(b => (b.checked = false));
    update();
  });
  done.textContent = String(boxes.filter(b => b.checked).length);
</script>
