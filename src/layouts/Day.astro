---
import Base from './Base.astro';
import Skyline from '../components/Skyline.astro';
import { trip } from '../data/itinerary';
const { day } = Astro.props;
const d = trip.days.find(x => x.day === day);
const routeCoords = JSON.stringify(trip.dailyRoutes[day] ?? []);
const dayLocations = JSON.stringify(
  trip.locations.filter(loc =>
    (trip.dailyRoutes[day] ?? []).some(([lat, lng]) =>
      Math.abs(loc.lat - lat) < 0.01 && Math.abs(loc.lng - lng) < 0.01
    )
  )
);
const mapCenter = JSON.stringify([d.lat, d.lng]);
const typeLabel = { food: '餐飲', shopping: '購物', transport: '交通', flight: '航班', hotel: '住宿', outdoor: '散步', ticket: '票券' };
const byType = [...new Set(d.activities.map(a => a.type))]
  .map(type => ({ type, total: d.activities.filter(a => a.type === type).reduce((s, a) => s + a.budget, 0) }))
  .filter(x => x.total > 0);
---

<Base title={`Day ${d.day}：${d.title}`}>
  <header class="hero compact">
    <div class="hero-inner">
      <a href="/" class="back">回總覽</a>
      <h1>Day {d.day} · {d.date}</h1>
      <p class="subtitle">{d.title}</p>
      <Skyline />
    </div>
  </header>

  <main class="container">
    <div class="chips" aria-label="切換天數">
      {trip.days.map(x => (
        <a href={`/day${x.day}`} aria-current={x.day === d.day ? 'page' : undefined}>Day {x.day}</a>
      ))}
    </div>

    <section class="card">
      <h2>時間軸</h2>
      <p class="desc-line" style="color:var(--muted);font-size:0.9rem;margin-bottom:1.25rem;">{d.subtitle}</p>
      <ol class="timeline">
        {d.activities.map(a => (
          <li class={`activity t-${a.type}`}>
            <div class="time">{a.time}</div>
            <div class="stop" aria-hidden="true"></div>
            <div>
              <div class="title">{a.icon} {a.title}{a.ko && <span class="ko" lang="ko">{a.ko}</span>}</div>
              <div class="desc">{a.desc}</div>
              <div class="row">
                <span class={`budget ${a.budget === 0 ? 'free' : ''}`}>{a.budget === 0 ? '不另計' : `₩${a.budget.toLocaleString()}`}</span>
                {a.gmap && <a class="gmap" href={a.gmap} target="_blank" rel="noopener">開啟地圖</a>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="card">
      <div class="day-header" style="margin-bottom:0.75rem;">
        <h2>路線</h2>
        <a href={`/map?day=${d.day}`} style="margin-left:auto;font-size:0.85rem;font-weight:600;">展開地圖</a>
      </div>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <div id={`day-map-${d.day}`} style="width:100%;height:300px;border-radius:6px;"></div>
    </section>

    <section class="card">
      <h2>本日花費（韓元）</h2>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem;">
        {byType.map(x => <span class={`tag tag-${x.type}`}>{typeLabel[x.type] ?? x.type} ₩{x.total.toLocaleString()}</span>)}
      </div>
      <table class="budget-table">
        <thead><tr><th>時間</th><th>項目</th><th>金額</th></tr></thead>
        <tbody>
          {d.activities.filter(a => a.budget > 0).map(a => (
            <tr>
              <td style="white-space:nowrap;">{a.time}</td>
              <td>{a.title}</td>
              <td style="text-align:right;">₩{a.budget.toLocaleString()}</td>
            </tr>
          ))}
          <tr class="total-row"><td></td><td>本日合計</td><td style="text-align:right;">₩{d.dayBudget.toLocaleString()}</td></tr>
        </tbody>
      </table>
    </section>
  </main>

  <footer class="footer">
    <a href="/">回總覽</a>
  </footer>
</Base>

<script define:vars={{ routeCoords, dayLocations, day, mapCenter }}>
  const coords = JSON.parse(routeCoords);
  const locs = JSON.parse(dayLocations);
  const mapId = `day-map-${day}`;
  const css = getComputedStyle(document.documentElement);
  const teal = css.getPropertyValue('--teal').trim() || '#1e7b76';
  const red = css.getPropertyValue('--red').trim() || '#b93a32';

  function initDayMap() {
    const L = window.L;
    if (!L || !document.getElementById(mapId)) return;
    const map = L.map(mapId).setView(JSON.parse(mapCenter), 14);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(map);

    if (coords.length >= 2) {
      L.polyline(coords, { color: teal, weight: 4, opacity: 0.85 }).addTo(map);
      map.fitBounds(coords, { padding: [32, 32] });
    }

    locs.forEach(loc => {
      L.circleMarker([loc.lat, loc.lng], {
        radius: 7, fillColor: red, color: '#fff', weight: 2, fillOpacity: 0.9,
      }).addTo(map).bindPopup(`<strong>${loc.name}</strong>`);
    });
  }

  const script = document.createElement('script');
  script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
  script.onload = initDayMap;
  document.head.appendChild(script);
</script>
